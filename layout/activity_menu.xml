<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menú principal"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primaryDark"
            android:layout_marginBottom="24dp"/>

        <!-- BOTONES -->
        <Button
            android:id="@+id/btnComidas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comidas del día"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/btnMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mapa"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"/>

        <Button
            android:id="@+id/btnProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Progreso"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"/>

        <!-- CONFIGURACIÓN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurar recordatorios"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primaryDark"
            android:layout_marginBottom="12dp"/>

        <!-- DESAYUNO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Desayuno"
                android:textSize="16sp"/>

            <Switch
                android:id="@+id/switchBreakfast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnHoraBreakfast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00"/>
        </LinearLayout>

        <!-- COMIDA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Comida"
                android:textSize="16sp"/>

            <Switch
                android:id="@+id/switchLunch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnHoraLunch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:00"/>
        </LinearLayout>

        <!-- CENA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cena"
                android:textSize="16sp"/>

            <Switch
                android:id="@+id/switchDinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnHoraDinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:00"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>