<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍏 Menú principal"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="20dp"/>

        <!-- DASHBOARD CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnComidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍽 Comidas del día"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🗺 Mapa de tiendas"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Mi progreso"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- CONFIGURACIÓN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ Recordatorios"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="12dp"/>

        <!-- CARD DESAYUNO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#111111"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🥐 Desayuno"
                android:textColor="@color/white"
                android:textSize="16sp"/>

            <Switch
                android:id="@+id/switchBreakfast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnHoraBreakfast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- CARD COMIDA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#111111"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🍛 Comida"
                android:textColor="@color/white"
                android:textSize="16sp"/>

            <Switch
                android:id="@+id/switchLunch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnHoraLunch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:00"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"/>
        </LinearLayout>

        <!-- CARD CENA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#111111"
            android:padding="14dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌙 Cena"
                android:textColor="@color/white"
                android:textSize="16sp"/>

            <Switch
                android:id="@+id/switchDinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnHoraDinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20:00"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>